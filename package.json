{
  "name": "claude-intercom",
  "version": "0.0.0",
  "description": "Make a Claude Code session an addressable peer on the pi-intercom bus.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "claude-intercom-mcp": "bin/claude-intercom-mcp.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "pi-intercom": "0.18.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "^5.9.0"
  }
}
